#!/bin/bash
# Chrome DevTools Startup Script
# Starts Chrome with remote debugging for MCP server

CHROME_PORT=9222
CHROME_DATA_DIR="/tmp/chrome-debug-mcp"

echo "Starting Chrome with remote debugging on port $CHROME_PORT..."

# Kill existing Chrome processes
pkill -f "chromium.*remote-debugging-port=$CHROME_PORT" 2>/dev/null

# Start Chrome with remote debugging
chromium \
    --remote-debugging-port=$CHROME_PORT \
    --no-sandbox \
    --disable-dev-shm-usage \
    --disable-web-security \
    --disable-features=VizDisplayCompositor \
    --user-data-dir=$CHROME_DATA_DIR \
    about:blank > /tmp/chrome-mcp.log 2>&1 &

# Wait for Chrome to start
echo "Waiting for Chrome to start..."
sleep 3

# Test connection
if curl -s "http://127.0.0.1:$CHROME_PORT/json/version" > /dev/null 2>&1; then
    echo "✅ Chrome started successfully with remote debugging"
    echo "📱 Debug URL: http://127.0.0.1:$CHROME_PORT"
    echo "🔧 Ready for chrome-devtools MCP server"
else
    echo "❌ Failed to start Chrome with remote debugging"
    echo "📋 Check logs: tail /tmp/chrome-mcp.log"
    exit 1
fi