# Ripgrep Configuration
# Fast text search tool, alternative to grep

# Search options
--smart-case
--line-number
--column
--with-filename

# Performance
--mmap

# Output formatting
--heading
--line-buffered
--no-messages

# File type handling
--type-add
web:*.{html,css,js,ts,jsx,tsx,vue,svelte}
config:*.{json,yaml,yml,toml,ini,conf}
docs:*.{md,mdx,txt,rst,adoc}
logs:*.{log,out}

# Ignore patterns (additional to .gitignore)
--glob
!.git/
!node_modules/
!__pycache__/
!*.min.js
!*.min.css
!.DS_Store
!Thumbs.db

# Context lines
--context=2

# Color output
--color=auto

# Binary file handling
--binary

# Hidden files
--hidden

# Follow symlinks
--follow