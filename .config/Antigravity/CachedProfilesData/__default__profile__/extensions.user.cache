":"Kilo Code","properties":{"kilo-code.allowedCommands":{"type":"array","items":{"type":"string"},"default":["git log","git diff","git show"],"description":"Commands that can be auto-executed when 'Always approve execute operations' is enabled"},"kilo-code.deniedCommands":{"type":"array","items":{"type":"string"},"default":[],"description":"Command prefixes that will be automatically denied without asking for approval. In case of conflicts with allowed commands, the longest prefix match takes precedence. Add * to deny all commands."},"kilo-code.commandExecutionTimeout":{"type":"number","default":0,"minimum":0,"maximum":600,"description":"Maximum time in seconds to wait for command execution to complete before timing out (0 = no timeout, 1-600s, default: 0s)"},"kilo-code.commandTimeoutAllowlist":{"type":"array","items":{"type":"string"},"default":[],"description":"Command prefixes that are excluded from the command execution timeout. Commands matching these prefixes will run without timeout restrictions."},"kilo-code.preventCompletionWithOpenTodos":{"type":"boolean","default":false,"description":"Prevent task completion when there are incomplete todos in the todo list"},"kilo-code.vsCodeLmModelSelector":{"type":"object","properties":{"vendor":{"type":"string","description":"The vendor of the language model (e.g. copilot)"},"family":{"type":"string","description":"The family of the language model (e.g. gpt-4)"}},"description":"Settings for VSCode Language Model API"},"kilo-code.customStoragePath":{"type":"string","default":"","description":"Custom storage path. Leave empty to use the default location. Supports absolute paths (e.g. 'D:\\KiloCodeStorage')"},"kilo-code.enableCodeActions":{"type":"boolean","default":true,"description":"Enable Kilo Code quick fixes"},"kilo-code.autoImportSettingsPath":{"type":"string","default":"","description":"Path to a Kilo Code configuration file to automatically import on extension startup. Supports absolute paths and paths relative to the home directory (e.g. '~/Documents/kilo-code-settings.json'). Leave empty to disable auto-import."},"kilo-code.maximumIndexedFilesForFileSearch":{"type":"number","default":10000,"minimum":5000,"maximum":500000,"description":"Maximum number of files to index for the @ file search feature. Higher values provide better search results in large projects but may use more memory. Default: 10,000."},"kilo-code.useAgentRules":{"type":"boolean","default":true,"description":"Enable loading of AGENTS.md files for agent-specific rules (see https://agent-rules.org/)"},"kilo-code.apiRequestTimeout":{"type":"number","default":600,"minimum":0,"maximum":86400,"description":"Maximum time in seconds to wait for API responses (0 = no timeout, 1-86400s, default: 600s). Higher values are recommended for local providers like LM Studio and Ollama that may need more processing time."},"kilo-code.newTaskRequireTodos":{"type":"boolean","default":false,"description":"Require todos parameter when creating new tasks with the new_task tool"},"kilo-code.enableSettingsSync":{"type":"boolean","default":true,"description":"Enable synchronization of Kilo Code settings across devices via VS Code Settings Sync. When enabled, your API configurations, custom modes, and preferences will automatically sync when you sign in to VS Code Settings Sync."},"kilo-code.codeIndex.embeddingBatchSize":{"type":"number","default":60,"minimum":1,"maximum":200,"description":"The batch size for embedding operations during code indexing. Adjust this based on your API provider's limits. Default is 60."},"kilo-code.toolProtocol":{"type":"string","enum":["xml","native"],"default":"xml","description":"Tool protocol to use for AI interactions. XML is the default and recommended protocol. Native is experimental and may not work with all providers."},"kilo-code.debug":{"type":"boolean","default":false,"description":"Enable debug mode to show additional buttons for viewing API conversation history and UI messages as prettified 