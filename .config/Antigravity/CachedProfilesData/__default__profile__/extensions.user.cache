eFullTag","title":"Copy Full Tag","category":"Container Registries"},{"command":"vscode-containers.registries.deleteImage","title":"Delete Image...","category":"Container Registries"},{"command":"vscode-containers.registries.deployImageToAzure","title":"Deploy Image to Azure App Service...","category":"Container Registries"},{"command":"vscode-containers.registries.deployImageToAca","title":"Deploy Image to Azure Container Apps...","category":"Container Registries"},{"command":"vscode-containers.registries.disconnectRegistry","title":"Disconnect","category":"Container Registries"},{"command":"vscode-containers.registries.genericV2.removeTrackedRegistry","title":"Disconnect from Generic Container Registry","category":"Container Registries"},{"command":"vscode-containers.registries.genericV2.addTrackedRegistry","title":"Connect to Generic Container Registry...","category":"Container Registries"},{"command":"vscode-containers.registries.dockerHub.openInBrowser","title":"Open in Browser","category":"Docker Hub"},{"command":"vscode-containers.registries.help","title":"Registries Help","category":"Container Registries","icon":"$(question)"},{"command":"vscode-containers.registries.logInToContainerCli","title":"Log In to container CLI","category":"Container Registries"},{"command":"vscode-containers.registries.logOutOfContainerCli","title":"Log Out of container CLI","category":"Container Registries"},{"command":"vscode-containers.registries.pullImage","title":"Pull Image","category":"Container Registries"},{"command":"vscode-containers.registries.pullRepository","title":"Pull Repository","category":"Container Registries"},{"command":"vscode-containers.registries.reconnectRegistry","title":"Re-enter credentials","category":"Container Registries"},{"command":"vscode-containers.registries.refresh","title":"Refresh","category":"Container Registries","icon":"$(refresh)"},{"command":"vscode-containers.volumes.configureExplorer","title":"Configure Explorer...","category":"Container Volumes","icon":"$(settings-gear)"},{"command":"vscode-containers.volumes.inspect","title":"Inspect","category":"Container Volumes"},{"command":"vscode-containers.volumes.prune","title":"Prune...","category":"Container Volumes","icon":"$(clear-all)"},{"command":"vscode-containers.volumes.refresh","title":"Refresh","category":"Container Volumes","icon":"$(refresh)"},{"command":"vscode-containers.volumes.remove","title":"Remove...","category":"Container Volumes"},{"command":"vscode-containers.help","title":"Container Help","category":"Containers","icon":"$(question)"},{"command":"vscode-containers.help.reportIssue","title":"Report Issue","category":"Containers"},{"command":"vscode-containers.help.openWalkthrough","title":"Open Container Tools Extension Walkthrough","category":"Containers"},{"command":"vscode-containers.chooseContainerRuntime","title":"Choose container runtime...","category":"Containers","icon":"$(tools)"},{"command":"vscode-containers.contexts.use","title":"Use","category":"Docker Contexts","icon":"$(check)"},{"command":"vscode-containers.contexts.remove","title":"Remove...","category":"Docker Contexts"},{"command":"vscode-containers.contexts.inspect","title":"Inspect","category":"Docker Contexts"},{"command":"vscode-containers.contexts.configureExplorer","title":"Configure Explorer...","category":"Docker Contexts","icon":"$(settings-gear)"},{"command":"vscode-containers.contexts.refresh","title":"Refresh","category":"Docker Contexts","icon":"$(refresh)"},{"command":"vscode-containers.contexts.help","title":"Docker Context Help","category":"Docker Contexts","icon":"$(question)"},{"command":"vscode-containers.activateContainerRuntimeProviders","title":"Activate Container Runtime Providers...","category":"Containers"},{"command":"vscode-containers.activateRegistryProviders","title":"Activate Registry Providers...","category":"Containers"}],"views":{"containersView":[{"id":"vscode-containers.views.containers","name":"Containers","icon":"resources/ContainerTools.svg"},{"id":"vscode-containers.views.images","name":"Images","icon":"resources/ContainerTools.svg"},{"id":"vscode-containers.views.registries","name":"Registries","icon":"resources/ContainerTools.svg"},{"id":"vscode-containers.views.networks","name":"Networks","icon":"resources/ContainerTools.svg","visibility":"collapsed"},{"id":"vscode-containers.views.volumes","name":"Volumes","icon":"resources/ContainerTools.svg","visibility":"collapsed"},{"id":"vscode-containers.views.dockerContexts","name":"Docker Contexts","icon":"resources/ContainerTools.svg","visibility":"collapsed"},{"id":"vscode-containers.views.help","name":"Help and Feedback","icon":"resources/ContainerTools.svg"}]},"viewsContainers":{"activitybar":[{"icon":"resources/ContainerTools.svg","id":"containersView","title":"Containers"}]},"walkthroughs":[{"id":"containersStart","title":"Getting Started with Container Tools","featuredFor":["Dockerfile","compose.yaml","docker-compose.yml","docker-compose.yaml","compose.yml"],"description":"Learn about Docker and the Container Tools extension for Visual Studio Code","steps":[{"id":"chooseContainerRuntime","title":"Choose your Container Runtime","completionEvents":["onCommand:vscode-containers.chooseContainerRuntime"],"description":"The Container Tools extension supports multiple container runtimes. Choose the one you want to use - you can change this anytime.\n[Choose Container Runtime](command:vscode-containers.chooseContainerRuntime)","media":{"markdown":"resources/walkthroughs/empty.md"}},{"id":"openFolder","title":"Open a Workspace Folder","completionEvents":["onCommand:workbench.action.files.openFolder"],"when":"workspaceFolderCount == 0 && !isMac","description":"Open a workspace folder to get started with Container Tools extension features.\n[Open Folder](command:workbench.action.files.openFolder)","media":{"markdown":"resources/walkthroughs/empty.md"}},{"id":"openFolderMac","title":"Open a Workspace Folder","completionEvents":["onCommand:workbench.action.files.openFileFolder"],"when":"workspaceFolderCount == 0 && isMac","description":"Open a workspace folder to get started with Container Tools extension features.\n[Open Folder](command:workbench.action.files.openFileFolder)","media":{"markdown":"resources/walkthroughs/empty.md"}},{"id":"scaffold","title":"Add Docker Files to Workspace","completionEvents":["onCommand:vscode-containers.configure","onCommand:vscode-containers.configureCompose"],"when":"workspaceFolderCount > 0","description":"A Dockerfile contains the instructions to assemble an image containing your app and its dependencies. Using this image to run your app in a container creates a production-like, reproducible runtime environment.\n\nIntelliSense support for authoring your Dockerfile is provided.\n[Add Docker Files](command:vscode-containers.configure)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/1g-addDockerFiles.gif","altText":"Modifying Dockerfiles"}},{"id":"buildImage","title":"Build an Image","completionEvents":["onCommand:vscode-containers.images.build"],"when":"workspaceFolderCount > 0","description":"The Container Tools extension makes it simple to build your image.\n[Build Image](command:vscode-containers.images.build)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/2g-buildImage.gif","altText":"Building a container image"}},{"id":"runContainer","title":"Run a Container","completionEvents":["onCommand:vscode-containers.images.run","onCommand:vscode-containers.compose.up","onCommand:vscode-containers.compose.up.subset","onCommand:vscode-containers.compose.down.subset"],"description":"You can run any image on your system including those you've built with a Dockerfile.\n[Run Image](command:vscode-containers.images.run)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/3g-runContainers.gif","altText":"Running a container"}},{"id":"containerExplorer","title":"Use the Container Explorer","completionEvents":["onView:vscode-containers.views.containers","onCommand:workbench.view.extension.containersView"],"description":"The Container Explorer makes it easy to manage, troubleshoot, and deploy containerized applications. The Container Explorer shows a number of container resources such as containers, images, volumes, networks, and container registries.\n\nThe right-click menu provides access to commonly used commands for each resource type.\n[Open Container Explorer](command:vscode-containers.views.containers.focus)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/4g-useExplorer.gif","altText":"Using the Container Explorer"}},{"id":"pushImage","title":"Push an Image to a Container Registry","completionEvents":["onCommand:vscode-containers.images.push"],"description":"The Container Tools Extension allows you to push your container image to Docker Hub, Azure Container Registry and other registry providers.\n[Push an Image](command:vscode-containers.images.push)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/5g-pushImage.gif","altText":"Pushing an image to a container registry"}},{"id":"azDeploy","title":"Deploy to Azure App Service","completionEvents":["onCommand:vscode-containers.registries.deployImageToAzure","onCommand:vscode-containers.registries.deployImageToAca"],"description":"The Container Tools extension helps you deploy your containerized applications and take advantage of a fully-managed platform using Azure App Service. Prior to deployment, the image must be uploaded to either Azure Container Registry or Docker Hub.\n\nAfter a successful deployment, select **Open Site** in the notification. Your container is running in Azure!\n[Deploy](command:vscode-containers.registries.deployImageToAzure)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/6g-deployToAppSvc.gif","altText":"Deploying to Azure App Service"}},{"id":"learn","title":"Learn More","description":"Great job! You've now completed Getting Started with Container Tools. But don't stop here! There are plenty of ways to become more proficient building containerized applications using the Container Tools extension.\n\nFor example, you can [debug a container](https://code.visualstudio.com/docs/containers/debug-common), or [run multiple containers](https://code.visualstudio.com/docs/containers/docker-compose) at once using Docker Compose.\n\nCheck out our [documentation](https://code.visualstudio.com/docs/containers/overview) to make the most of the Container Tools extension for VS Code!","completionEvents":["onStepSelected"],"media":{"markdown":"resources/walkthroughs/empty.md"}}]}]},"engines":{"vscode":"^1.104.0"},"capabilities":{"virtualWorkspaces":false,"untrustedWorkspaces":{"supported":"limited","description":"Workspace must be trusted in order to perform relevant container actions.","restrictedConfigurations":["containers.commands.build","containers.commands.run","containers.commands.runInteractive","containers.commands.attach","containers.commands.logs","containers.commands.composeUp","containers.commands.composeUpSubset","containers.commands.composeDown","containers.environment","containers.scaffolding.templatePath","containers.containerCommand","containers.composeCommand","containers.containerClient","containers.orchestratorClient"]}},"scripts":{"watch":"webpack --watch","build":"webpack --mode production --devtool hidden-source-map","ci-build":"npm test","package":"vsce package","ci-package":"npm test && vsce package","lint":"eslint --max-warnings 0 src --ext ts","test":"node ./out/test/runTest.js","pretest":"tsc -p ./","test-watch":"tsc -watch -p ./"},"extensionDependencies":["vscode.docker","vscode.yaml"],"enabledApiProposals":["authenticationChallenges"],"devDependencies":{"@azure/arm-appservice":"^15.0.0","@types/fs-extra":"^11.0.1","@types/mocha":"^10.0.1","@types/node":"20.x","@types/semver":"^7.3.13","@types/vscode":"1.104.0","@types/xml2js":"^0.4.11","@typescript-eslint/eslint-plugin":"^8.26.1","@typescript-eslint/parser":"^8.26.1","@vscode/test-electron":"^2.3.9","@vscode/vsce":"^3.1.0","chai":"^5.2.0","copy-webpack-plugin":"^13.0.0","eslint":"^9.22.0","glob":"^11.0.1","mocha":"^11.1.0","node-loader":"^2.0.0","ts-loader":"^9.4.2","typescript":"^5.0.4","umd-compat-loader":"^2.1.2","webpack":"^5.94.0","webpack-bundle-analyzer":"^4.8.0","webpack-cli":"^6.0.1"},"dependencies":{"@azure/arm-authorization":"^9.0.0","@azure/arm-containerregistry":"^10.1.0","@azure/storage-blob":"^12.14.0","@microsoft/compose-language-service":"^0.4.0","@microsoft/vscode-azext-azureappservice":"^3.6.7","@microsoft/vscode-azext-azureauth":"^4.2.2","@microsoft/vscode-azext-azureutils":"^3.5.2","@microsoft/vscode-azext-utils":"^3.4.2","@microsoft/vscode-container-client":"^0.4.2","@microsoft/vscode-docker-registries":"^0.3.0","@microsoft/vscode-processutils":"^0.1.1","dayjs":"^1.11.7","dockerfile-language-server-nodejs":"^0.14.1","fs-extra":"^11.1.1","gradle-to-js":"^2.0.1","handlebars":"^4.7.7","semver":"^7.5.2","tar":"^6.2.1","vscode-languageclient":"^9.0.1","vscode-tas-client":"^0.1.75","xml2js":"^0.6.0"}},"location":{"$mid":1,"path":"/home/archbtw/.antigravity/extensions/ms-azuretools.vscode-containers-2.2.0-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"ms-azuretools","metadata":{"installedTimestamp":1766099120322,"pinned":false,"source":"gallery","id":"2cd1d691-3d69-4d2d-ae39-fda4bc4cfd3d","publisherId":"52b787f2-79a9-4f32-99b4-393afe3005d3","publisherDisplayName":"ms-azuretools","targetPlatform":"universal","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":7190307},"isValid":true,"validations":[],"preRelease":false},{"type":1,"identifier":{"id":"kilocode.kilo-code","uuid":"849d53b8-0eb4-4e6b-b73f-870eefcbbf1b"},"manifest":{"name":"kilo-code","displayName":"Kilo Code AI Agent","description":"Open Source AI coding assistant for planning, building, and fixing code.","publisher":"kilocode","version":"4.140.0","icon":"assets/icons/logo-outline-black.png","galleryBanner":{"color":"#FFFFFF","theme":"light"},"engines":{"vscode":"^1.84.0","node":"20.19.2"},"extensionKind":["workspace"],"author":{"name":"Kilo Code"},"repository":{"type":"git","url":"https://github.com/Kilo-Org/kilocode"},"homepage":"https://kilo.ai","categories":["AI","Chat","Programming Languages","Education","Snippets","Testing"],"keywords":["kilo","claude","dev","mcp","openrouter","coding","agent","autonomous","chatgpt","sonnet","ai","llama","Kilo Code","kilocode"],"activationEvents":["onLanguage","onStartupFinished"],"main":"./dist/extension.js","contributes":{"walkthroughs":[{"id":"kiloCodeWalkthrough","title":"5 ways Kilo Code helps you code","description":"You now have a personal AI coding assistant.","steps":[{"id":"welcome","title":"Write code for you","description":"Describe what you want to build. Kilo Code will write it from scratch, generate the files, and run them for you.","media":{"markdown":"./dist/walkthrough/step1.md"}},{"id":"getting-started","title":"Understand your codebase","description":"Need clarity on how something works? Ask Kilo Code about any part of your files and get a clear explanation.","media":{"markdown":"./dist/walkthrough/step2.md"},"content":{"path":"./dist/walkthrough/step2.md"}},{"id":"modes","title":"Get things working again","description":"Stuck on an error? Kilo Code can find the issue, fix it, and get your code running.","media":{"markdown":"./dist/walkthrough/step3.md"}},{"id":"code-actions","title":"Plan your logic","description":"Not sure where to start? Map out your logic and structure before writing a single line of code.","media":{"markdown":"./dist/walkthrough/step4.md"}},{"id":"advanced-features","title":"And more","description":"Improve your prompt, add context, or create your own custom modes.","media":{"markdown":"./dist/walkthrough/step5.md"}}]}],"viewsContainers":{"activitybar":[{"id":"kilo-code-ActivityBar","title":"Kilo Code","icon":"assets/icons/kilo.png","darkIcon":"assets/icons/kilo-dark.png"}]},"views":{"kilo-code-ActivityBar":[{"type":"webview","id":"kilo-code.SidebarProvider","name":"Kilo Code","icon":"assets/icons/kilo.png","darkIcon":"assets/icons/kilo-dark.png"}]},"commands":[{"command":"kilo-code.plusButtonClicked","title":"New Task","icon":"$(add)"},{"command":"kilo-code.mcpButtonClicked","title":"MCP Servers","icon":"$(server)"},{"command":"kilo-code.importSettings","title":"Import Settings","category":"Kilo Code"},{"command":"kilo-code.exportSettings","title":"Export Settings","category":"Kilo Code"},{"command":"kilo-code.promptsButtonClicked","title":"Modes","icon":"$(organization)"},{"command":"kilo-code.historyButtonClicked","title":"Task History","icon":"$(history)"},{"command":"kilo-code.marketplaceButtonClicked","title":"Marketplace","icon":"$(extensions)"},{"command":"kilo-code.popoutButtonClicked","title":"Open in Editor","icon":"$(link-external)"},{"command":"kilo-code.settingsButtonClicked","title":"Settings","icon":"$(settings-gear)"},{"command":"kilo-code.helpButtonClicked","title":"Documentation","icon":"$(question)"},{"command":"kilo-code.openInNewTab","title":"Open In New Tab","category":"Kilo Code"},{"command":"kilo-code.explainCode","title":"Explain Code","category":"Kilo Code"},{"command":"kilo-code.fixCode","title":"Fix Code","category":"Kilo Code"},{"command":"kilo-code.improveCode","title":"Improve Code","category":"Kilo Code"},{"command":"kilo-code.addToContext","title":"Add To Context","category":"Kilo Code"},{"command":"kilo-code.addToContextAndFocus","title":"Add to Context and Focus","category":"Kilo Code"},{"command":"kilo-code.newTask","title":"New Task","category":"Kilo Code"},{"command":"kilo-code.terminalAddToContext","title":"Add Terminal Content to Context","category":"Kilo Code AI Agent"}