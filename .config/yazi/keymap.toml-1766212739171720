# Global keymaps
[tabs]
prepend_keymap = [
  # Tab management
  { on = ["g", "t"], run = "tab_create", desc = "New tab (current)" },
  { on = ["g", "T"], run = "tab_create --current --layout=parent", desc = "New tab (parent)" },
  { on = ["<C-q>"], run = "tab_close", desc = "Close current tab" },
  { on = ["<C-n>"], run = "tab_switch 1 --relative", desc = "Next tab" },
  { on = ["<C-p>"], run = "tab_switch -1 --relative", desc = "Prev tab" },
]

[tab]
prepend_keymap = [
  # Navigation
  { on = ["h"], run = "arrow -1", desc = "Move cursor up" },
  { on = ["j"], run = "arrow 1", desc = "Move cursor down" },
  { on = ["k"], run = "arrow -5", desc = "Move cursor up 5 positions" },
  { on = ["l"], run = "arrow 5", desc = "Move cursor down 5 positions" },

  # Page navigation
  { on = ["<C-u>"], run = "arrow -50%", desc = "Move cursor up half page" },
  { on = ["<C-d>"], run = "arrow 50%", desc = "Move cursor down half page" },
  { on = ["<C-b>"], run = "arrow -100%", desc = "Move cursor up one page" },
  { on = ["<C-f>"], run = "arrow 100%", desc = "Move cursor down one page" },

  # Alternative page navigation
  { on = ["K"], run = "arrow -50%", desc = "Move cursor up half page" },
  { on = ["J"], run = "arrow 50%", desc = "Move cursor down half page" },
  { on = ["<A-k>"], run = "arrow -5", desc = "Move cursor up 5 positions" },
  { on = ["<A-j>"], run = "arrow 5", desc = "Move cursor down 5 positions" },

  # Parent directory navigation
  { on = ["p"], run = "plugin parent", desc = "Go to parent directory" },
  { on = ["<C-h>"], run = "cd ..", desc = "Go to parent directory" },
  { on = ["<C-l>"], run = "enter", desc = "Enter the child directory" },
  { on = ["<Left>"], run = "back", desc = "Go back in history" },
  { on = ["<Right>"], run = "forward", desc = "Go forward in history" },

  # Operations
  { on = ["<Space>"], run = "select --state=toggle", desc = "Select the current file" },
  { on = ["v"], run = "visual_mode --state=toggle", desc = "Toggle visual mode selection" },
  { on = ["V"], run = "visual_mode --state=off", desc = "Turn off visual mode selection" },

  # File operations
  { on = ["o"], run = "open", desc = "Open the selected files" },
  { on = ["O"], run = "open --interactive", desc = "Open the selected files interactively" },
  { on = ["e"], run = "open", desc = "Open the selected files" },  # Changed from append to prepend
  { on = ["E"], run = "open --interactive", desc = "Open the selected files interactively" },  # Changed from append to prepend
  { on = ["a"], run = "create", desc = "Create a file or directory" },
  { on = ["A"], run = "create --dir", desc = "Create a directory" },
  { on = ["r"], run = "rename", desc = "Rename selected files" },
  { on = ["c"], run = "copy", desc = "Copy selected files" },
  { on = ["x"], run = "cut", desc = "Cut selected files" },
  { on = ["p"], run = "paste", desc = "Paste cut/copied files" },
  { on = ["P"], run = "paste --force=true", desc = "Paste cut/copied files with overwrite" },
  { on = ["d"], run = "remove", desc = "Remove selected files" },
  { on = ["D"], run = "remove --force=true", desc = "Remove selected files without confirmation" },
  { on = ["y"], run = "yank", desc = "Yank (copy/cut) selected files" },
  { on = ["Y"], run = "unyank", desc = "Cancel yank status of selected files" },
  { on = ["X"], run = "unyank", desc = "Cancel yank status of selected files" },
  { on = ["m"], run = "move", desc = "Move selected files" },

  # Application
  { on = ["."], run = "shell --block", desc = "Open shell in current directory" },
  { on = ["!"], run = 'shell "$SHELL" --block', desc = "Open shell here" },
  { on = [":"], run = "shell --block --cursor", desc = "Run a shell command" },
  { on = ["f"], run = "plugin searchjump --auto-cd", desc = "Search Jump" },
  { on = ["F"], run = "search --via=fd", desc = "Search files by name using fd" },
  { on = ["'"], run = "shell --block=$SHELL", desc = "Open shell in current directory" },
  { on = ["<C-s>"], run = "save --sync", desc = "Save current state to clipboard" },
  { on = [";"], run = "shell", desc = "Run a shell command without blocking" },

  # Copy to clipboard
  { on = ["<C-y>"], run = 'shell -- for path in "$@"; do echo "file://$path"; done | wl-copy -t text/uri-list', desc = "Copy to clipboard" },

  # Git integration
  { on = ["g", "r"], run = 'shell -- ya cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"', desc = "Root of Git Repo" },

  # Sorting
  { on = [","], run = "sort --reverse=false", desc = "Sort by name (ascending)" },
  { on = ["<"], run = "sort --reverse=true", desc = "Sort by name (descending)" },
  { on = ["."], run = "sort --by=time --reverse=false", desc = "Sort by time (ascending)" },
  { on = [">"], run = "sort --by=time --reverse=true", desc = "Sort by time (descending)" },

  # Other
  { on = ["?"], run = "help", desc = "Show help" },
  { on = ["q"], run = "close", desc = "Close the manager" },
  { on = ["<C-c>"], run = "close", desc = "Close the manager" },
  { on = ["<C-z>"], run = "suspend", desc = "Suspend the manager" },

  # Tab switching
  { on = ["H"], run = "tab_switch -1 --relative", desc = "Switch to the previous tab" },
  { on = ["L"], run = "tab_switch 1 --relative", desc = "Switch to the next tab" },
  { on = ["<"], run = "tab_swap -1", desc = "Swap current tab with previous tab" },
  { on = [">"], run = "tab_swap 1", desc = "Swap current tab with next tab" },
]

[manager]
prepend_keymap = [
  # Sync operations
  { on = ["<C-g>"], run = "sync --all", desc = "Sync all settings" },
  { on = ["s", "a"], run = "sync --all", desc = "Sync all settings" },
  { on = ["s", "c"], run = "sync --current", desc = "Sync current directory" },
  { on = ["s", "s"], run = "plugin select", desc = "Select a file with fzf" },
]

[preview]
prepend_keymap = [
  # Preview navigation
  { on = ["w"], run = "seek 1", desc = "Preview next file" },
  { on = ["s"], run = "seek -1", desc = "Preview previous file" },
  { on = ["W"], run = "seek 10", desc = "Preview 10 files forward" },
  { on = ["S"], run = "seek -10", desc = "Preview 10 files backward" },
  { on = ["<C-u>"], run = "seek -50%", desc = "Seek up 50% of the preview height" },
  { on = ["<C-d>"], run = "seek 50%", desc = "Seek down 50% of the preview height" },
]

[input]
prepend_keymap = [
  { on = ["<C-k>"], run = "arrow -1", desc = "Move cursor up" },
  { on = ["<C-j>"], run = "arrow 1", desc = "Move cursor down" },
  { on = ["<C-u>"], run = "kill 0", desc = "Kill to beginning of line" },
  { on = ["<C-w>"], run = "kill before", desc = "Kill to beginning of current word" },
  { on = ["<C-c>"], run = "escape", desc = "Cancel" },
  { on = ["<C-d>"], run = "close", desc = "Close" },
  { on = ["<C-a>"], run = "move 0", desc = "Move to beginning of line" },
  { on = ["<C-e>"], run = "move 1000", desc = "Move to end of line" },
  { on = ["<A-b>"], run = "move -word", desc = "Move to beginning of current word" },
  { on = ["<A-f>"], run = "move word", desc = "Move to end of current word" },
]

[completion]
prepend_keymap = [
  { on = ["<C-k>"], run = "arrow -1", desc = "Move cursor up" },
  { on = ["<C-j>"], run = "arrow 1", desc = "Move cursor down" },
  { on = ["<C-p>"], run = "arrow -1", desc = "Move cursor up" },
  { on = ["<C-n>"], run = "arrow 1", desc = "Move cursor down" },
  { on = ["<C-d>"], run = "close", desc = "Close completion menu" },
  { on = ["<Tab>"], run = "escape", desc = "Accept completion" },
]

[help]
prepend_keymap = [
  { on = ["<Esc>"], run = "escape", desc = "Close help" },
  { on = ["q"], run = "close", desc = "Close help" },
  { on = ["<C-c>"], run = "close", desc = "Close help" },
]
